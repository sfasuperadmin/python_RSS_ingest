# Copy to .env and fill in. Loaded automatically by config.py (python-dotenv).
# These point the ingester at the SAME MySQL database the Yii backend uses.

SH_DB_HOST=127.0.0.1
SH_DB_PORT=3306
SH_DB_USER=root
SH_DB_PASSWORD=root
SH_DB_NAME=sfa_06Aug

# TLS: behind a corporate proxy, point this at the proxy CA bundle (preferred).
# SH_CA_BUNDLE=/path/to/corporate-ca.pem
# Last resort on a trusted network only:
# SH_VERIFY_SSL=0

# Optional tuning
SH_HTTP_TIMEOUT=30
SH_MAX_WORKERS=8
SH_POLL_INTERVAL_MINUTES=60
SH_MAX_ITEMS_PER_FEED=100
# SH_USER_AGENT=SafeHands-RegBot/1.0 (+compliance feed; contact: admin@safehands.in)
